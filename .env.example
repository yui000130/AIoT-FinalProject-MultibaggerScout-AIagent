# 複製這個檔案並改名為 .env，再填入自己的 token
# FinMind token 申請：https://finmindtrade.com/ 註冊後在會員頁取得
FINMIND_API_TOKEN=

# Gemini API key 申請：https://aistudio.google.com/apikey 登入 Google 帳號後建立
GEMINI_API_KEY=

# ===== FinMind API 端點 =====

# 通用資料查詢：用 dataset 指定資料集（股價、財報、法人買賣、融資融券、月營收…）
# 參數：dataset, data_id, start_date, end_date
FINMIND_URL_DATA=https://api.finmindtrade.com/api/v4/data

# 個股分點進出：某股票當天各券商的買賣張數與價格（單次一天）
# 參數：data_id 或 securities_trader_id（擇一）, date
FINMIND_URL_TRADING_DAILY_REPORT=https://api.finmindtrade.com/api/v4/taiwan_stock_trading_daily_report

# 權證分點進出：某權證當天各券商的買賣明細（單次一天）
# 參數：data_id 或 securities_trader_id（擇一）, date
FINMIND_URL_WARRANT_TRADING_DAILY_REPORT=https://api.finmindtrade.com/api/v4/taiwan_stock_warrant_trading_daily_report

# 券商區間彙總：特定券商在特定股票一段期間的進出統計
# 參數：data_id, securities_trader_id, start_date, end_date
FINMIND_URL_TRADING_DAILY_REPORT_SECID_AGG=https://api.finmindtrade.com/api/v4/taiwan_stock_trading_daily_report_secid_agg

# 個股／指數即時快照：最新成交價、漲跌、成交量（可多檔，或空值取全部；指數 3 碼如 001 加權、101 櫃買）
# 參數：data_id
FINMIND_URL_STOCK_TICK_SNAPSHOT=https://api.finmindtrade.com/api/v4/taiwan_stock_tick_snapshot

# 期貨即時快照：台指期 TXF、微台 TMF、個股期 CDF 等最新報價（空值取全部）
# 參數：data_id
FINMIND_URL_FUTURES_SNAPSHOT=https://api.finmindtrade.com/api/v4/taiwan_futures_snapshot

# 選擇權即時快照：月選 TXO、週三週選 TX1~TX5、週五週選 TXU~TXZ 最新報價（空值取全部）
# 參數：data_id
FINMIND_URL_OPTIONS_SNAPSHOT=https://api.finmindtrade.com/api/v4/taiwan_options_snapshot
